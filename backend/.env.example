# Base de datos Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Puerto (opcional, default 3000)
PORT=3000

# Orígenes permitidos por CORS (separados por coma, opcional)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Asistente virtual (Gemini) - agrega tu API key manualmente
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
